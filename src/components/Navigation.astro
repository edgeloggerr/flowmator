---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Features', href: '/features' },
  { name: 'How It Works', href: '/how-it-works' },
  { name: 'Setup', href: '/setup' },
  { name: 'Documentation', href: '/documentation' },
  { name: 'Journal', href: '/blog' },
  { name: 'Changelog', href: '/changelog' },
];

const mobileBottomItems = [
  {
    name: 'Home',
    href: '/',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`
  },
  {
    name: 'Features',
    href: '/features',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`
  },
  {
    name: 'Engine',
    href: '/how-it-works',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />`
  },
  {
    name: 'Docs',
    href: '/documentation',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`
  },
  {
    name: 'Journal',
    href: '/blog',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />`
  },
  {
    name: 'Setup',
    href: 'https://chromewebstore.google.com/detail/angiaegmoljbdkhkjkmjligbodgohfpm?utm_source=item-share-cb',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />`
  }
];
---

<!-- Top Floating Navigation Bar -->
<header class="fixed top-0 left-0 right-0 z-50 px-3 sm:px-4 py-3 sm:py-4 transition-all duration-300" id="mainHeader">
  <div class="max-w-6xl mx-auto">
    <nav class="glass-tier2 rounded-full px-3.5 sm:px-6 py-2.5 flex items-center justify-between border border-white/15 shadow-xl transition-all duration-300">
      
      <!-- Brand Logo & Wordmark -->
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl overflow-hidden glass-tier3 p-1 flex items-center justify-center border border-white/20 shadow-md group-hover:scale-105 transition-transform">
          <img src="/icons/icon32.png" alt="Flowmator Logo" class="w-full h-full object-contain" />
        </div>
        <div class="flex items-center gap-1.5">
          <span class="font-bold text-sm sm:text-base tracking-tight text-white group-hover:text-violet-electric transition-colors">Flowmator</span>
          <span class="hidden xs:inline-block text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-violet-600/20 text-aqua-liquid border border-violet-500/30">
            v1.0
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all duration-200 ${
                isActive
                  ? 'glass-tier3 text-white border border-white/20 shadow-sm'
                  : 'text-brandText-secondary hover:text-white hover:bg-white/5'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </div>

      <!-- Action Buttons (Right-aligned, perfectly vertically centered) -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- Compact, Centered Download CTA -->
        <a
          href="/setup"
          class="glass-btn-primary h-8 px-3.5 text-[11px] sm:text-xs flex items-center justify-center gap-1.5 font-semibold shadow-md shrink-0 hover:scale-105 transition-all"
        >
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Get Flowmator</span>
          <span class="text-[9px] opacity-80 font-normal hidden sm:inline">Free</span>
        </a>

        <!-- Mobile Hamburger Toggle Button -->
        <button
          id="mobileMenuBtn"
          class="md:hidden h-8 w-8 rounded-full glass-tier3 text-brandText-secondary hover:text-white flex items-center justify-center focus:outline-none transition-colors"
          aria-label="Toggle navigation menu"
        >
          <svg id="hamburgerIcon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="closeIcon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </nav>
  </div>
</header>

<!-- Mobile Fullscreen Liquid Glass Backdrop Blur Overlay -->
<div
  id="mobileMenuBackdrop"
  class="fixed inset-0 bg-graphite-900/65 backdrop-blur-xl z-40 hidden md:hidden transition-all duration-300"
></div>

<!-- Mobile Dropdown Menu with Rich Liquid Glass Surface -->
<div
  id="mobileMenu"
  class="fixed top-18 left-3.5 right-3.5 z-50 hidden md:hidden p-5 rounded-3xl bg-graphite-900/85 backdrop-blur-2xl border border-white/20 shadow-2xl ring-1 ring-white/10 space-y-1.5 transition-all duration-300"
>
  <div class="text-[10px] font-mono uppercase tracking-wider text-aqua-liquid px-3 pb-2 border-b border-white/10">
    Navigation Menu
  </div>

  <div class="grid grid-cols-1 gap-1 pt-1">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-medium transition-all ${
            isActive
              ? 'bg-violet-600/35 text-white font-semibold border border-violet-400/30 shadow-md'
              : 'text-brandText-secondary hover:text-white hover:bg-white/5'
          }`}
        >
          <span>{link.name}</span>
          <span class="text-brandText-tertiary text-[11px]">→</span>
        </a>
      );
    })}
  </div>

  <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs px-2">
    <a href="/support" class="text-aqua-liquid hover:underline font-medium text-[11px] flex items-center gap-1">
      <span>Support & Diagnostics</span>
      <span>➔</span>
    </a>
    <span class="text-[10px] font-mono text-brandText-tertiary">Flowmator v1.0.0</span>
  </div>
</div>

<!-- ============================================================
     MOBILE BOTTOM DOCK ICON NAV BAR (Sleek Liquid Glass)
============================================================ -->
<div class="fixed bottom-3.5 left-3.5 right-3.5 z-40 md:hidden pointer-events-auto">
  <div class="glass-tier2 backdrop-blur-2xl bg-graphite-900/90 border border-white/20 rounded-full py-1.5 px-2 flex items-center justify-around shadow-2xl ring-1 ring-white/10 max-w-md mx-auto">
    {mobileBottomItems.map((item) => {
      const isActive = item.href === '/'
        ? currentPath === '/'
        : currentPath.startsWith(item.href);

      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center py-1 px-2.5 rounded-full text-center transition-all duration-200 relative group ${
            isActive
              ? 'text-white'
              : 'text-brandText-tertiary hover:text-brandText-secondary'
          }`}
          title={item.name}
        >
          <div class={`w-5 h-5 flex items-center justify-center transition-transform ${isActive ? 'scale-110 text-aqua-liquid' : 'group-hover:scale-105'}`}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon}></svg>
          </div>
          <span class={`text-[9px] font-medium tracking-tight mt-0.5 leading-none ${isActive ? 'text-aqua-liquid font-bold' : ''}`}>
            {item.name}
          </span>
          {isActive && (
            <span class="absolute -bottom-0.5 w-1 h-1 rounded-full bg-aqua-liquid shadow-sm shadow-aqua-liquid"></span>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  // Mobile drawer and backdrop toggle
  const mobileBtn = document.getElementById('mobileMenuBtn');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileMenuBackdrop = document.getElementById('mobileMenuBackdrop');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');

  function toggleMenu() {
    const isHidden = mobileMenu?.classList.contains('hidden');
    if (isHidden) {
      mobileMenu?.classList.remove('hidden');
      mobileMenuBackdrop?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden'; // prevent background scrolling while open
    } else {
      mobileMenu?.classList.add('hidden');
      mobileMenuBackdrop?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  mobileBtn?.addEventListener('click', toggleMenu);
  mobileMenuBackdrop?.addEventListener('click', toggleMenu);

  // Close mobile drawer when clicking any link inside it
  const mobileLinks = mobileMenu?.querySelectorAll('a');
  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileMenuBackdrop?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    });
  });

  // Dynamic header background on scroll
  const header = document.getElementById('mainHeader');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 30) {
      header?.classList.add('py-2');
      header?.classList.remove('py-3', 'sm:py-4');
    } else {
      header?.classList.remove('py-2');
      header?.classList.add('py-3', 'sm:py-4');
    }
  });
</script>
