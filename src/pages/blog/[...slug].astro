---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Clock, Calendar, ArrowLeft, ArrowRight, Tag, Bookmark, CheckCircle2, Shield, User } from 'lucide-react';
import { SITE_CONFIG, getCanonicalUrl, generateArticleSchema, generateBreadcrumbSchema } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const cleanSlug = post.id.replace(/\.mdx?$/, '');
const articleUrl = getCanonicalUrl(`/blog/${cleanSlug}`);

// Fetch related articles
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && (post.data.relatedSlugs?.includes(p.id.replace(/\.mdx?$/, '')) || p.data.category === post.data.category))
  .slice(0, 3);

// Breadcrumb Schema
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Journal', url: '/blog' },
  { name: post.data.category, url: `/blog/category/${post.data.category.toLowerCase().replace(/\s+/g, '-')}` },
  { name: post.data.title, url: articleUrl }
];

const articleSchema = generateArticleSchema({
  title: post.data.title,
  description: post.data.description,
  url: articleUrl,
  publishedDate: post.data.publishedDate,
  modifiedDate: post.data.updatedDate,
  author: post.data.author,
  category: post.data.category,
  keywords: post.data.tags
});

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs);
const compositeSchema = [articleSchema, breadcrumbSchema];
---

<Layout
  title={`${post.data.title} | Flowmator Journal`}
  description={post.data.description}
  canonical={articleUrl}
  ogType="article"
  publishedTime={post.data.publishedDate}
  modifiedTime={post.data.updatedDate}
  author={post.data.author}
  section={post.data.category}
  tags={post.data.tags}
  schema={compositeSchema}
>
  <article class="px-4 py-12 md:py-20 max-w-4xl mx-auto space-y-12">
    
    {/* Breadcrumbs Navigation */}
    <nav class="flex items-center gap-2 text-xs text-brandText-tertiary overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-white transition-colors">Journal</a>
      <span>/</span>
      <span class="text-aqua-liquid font-medium">{post.data.category}</span>
    </nav>

    {/* Header Info */}
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
        <span class="px-3 py-1 rounded-full bg-violet-600/20 text-aqua-liquid border border-violet-500/30 font-semibold">
          {post.data.category}
        </span>
        <span class="text-brandText-tertiary flex items-center gap-1">
          <Clock className="w-3.5 h-3.5" /> {post.data.readingTime} min read
        </span>
        <span class="text-brandText-tertiary flex items-center gap-1">
          <Calendar className="w-3.5 h-3.5" /> Published {post.data.publishedDate}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.12]">
        {post.data.title}
      </h1>

      {/* Answer-First Excerpt Box */}
      <div class="p-5 rounded-2xl glass-tier2 border-l-4 border-l-aqua-liquid border-white/10 text-xs sm:text-sm text-brandText-primary leading-relaxed font-medium bg-scrim">
        <strong class="text-white block mb-1">Key Takeaway & Direct Answer:</strong>
        {post.data.excerpt}
      </div>

      <div class="flex items-center gap-3 text-xs text-brandText-tertiary pt-2 border-b border-white/10 pb-6">
        <span class="flex items-center gap-1.5 text-white font-medium">
          <User className="w-3.5 h-3.5 text-violet-electric" /> {post.data.author}
        </span>
        <span>•</span>
        <span>Verified against Flowmator Architecture</span>
      </div>
    </div>

    {/* Table of Contents (if multiple H2/H3 headings exist) */}
    {headings && headings.length > 2 && (
      <div class="glass-tier3 rounded-2xl p-5 border border-white/10 space-y-3">
        <span class="text-xs font-bold text-white uppercase tracking-wider block">In this guide:</span>
        <ul class="space-y-1.5 text-xs text-brandText-secondary">
          {headings.filter((h) => h.depth <= 3).map((h) => (
            <li class={`hover:text-aqua-liquid transition-colors ${h.depth === 3 ? 'pl-4 text-brandText-tertiary' : 'font-medium'}`}>
              <a href={`#${h.slug}`}>→ {h.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* Main Article Body */}
    <div class="prose prose-invert max-w-none space-y-6 text-sm sm:text-base text-brandText-secondary leading-relaxed">
      <Content />
    </div>

    {/* Tags */}
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="pt-6 border-t border-white/10 flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-brandText-tertiary mr-1">Topics:</span>
        {post.data.tags.map((tag) => (
          <span class="text-xs px-2.5 py-1 rounded-full bg-graphite-900/80 border border-white/10 text-brandText-secondary">
            #{tag}
          </span>
        ))}
      </div>
    )}

    {/* Contextual Flowmator CTA Box */}
    <div class="p-8 rounded-3xl glass-tier2 border border-white/15 relative overflow-hidden space-y-4 shadow-2xl">
      <div class="flex items-center gap-2 text-aqua-liquid text-xs font-mono font-semibold uppercase">
        <Shield className="w-4 h-4 text-emerald-400" />
        <span>Workflow Automation Suite</span>
      </div>
      <h3 class="text-xl sm:text-2xl font-bold text-white">
        Automate your Google Flow sequences with verified results
      </h3>
      <p class="text-xs sm:text-sm text-brandText-secondary leading-relaxed max-w-2xl">
        Stop babysitting the browser. Use Flowmator's Safe Sequence Mode to catalog canvas image tiles, clear rate-limit throttles automatically, and preserve storyboard continuity.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a href="/setup" class="glass-btn-primary px-6 py-2.5 text-xs font-semibold flex items-center gap-2">
          <span>Install Flowmator Free</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
        <a href="/documentation" class="glass-btn-secondary px-5 py-2.5 text-xs">
          Explore Documentation
        </a>
      </div>
    </div>

    {/* Related Articles */}
    {relatedPosts.length > 0 && (
      <div class="space-y-6 pt-6 border-t border-white/10">
        <h3 class="text-lg font-bold text-white">Related Technical Publications</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedPosts.map((rel) => (
            <a
              href={`/blog/${rel.id.replace(/\.mdx?$/, '')}`}
              class="glass-tier3 p-5 rounded-2xl border border-white/10 block hover:border-violet-electric/40 transition-all group"
            >
              <span class="text-[10px] font-mono text-aqua-liquid block mb-1">{rel.data.category}</span>
              <h4 class="text-xs font-bold text-white group-hover:text-violet-electric transition-colors line-clamp-2 leading-snug">
                {rel.data.title}
              </h4>
              <p class="text-[11px] text-brandText-tertiary mt-2 line-clamp-2">
                {rel.data.excerpt}
              </p>
            </a>
          ))}
        </div>
      </div>
    )}

  </article>
</Layout>
