---
import Layout from '../../layouts/Layout.astro';
import BlogSearchIsland from '../../components/BlogSearchIsland';
import { getCollection } from 'astro:content';
import { BookOpen, Sparkles, Clock, Calendar, ArrowRight, Tag } from 'lucide-react';
import { SITE_CONFIG, getCanonicalUrl } from '../../config/site';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);

const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];

const categories = [
  'Google Flow AI',
  'Prompt Automation',
  'AI Storyboarding',
  'Creator Productivity',
  'Technical Guides'
];

const articlesForSearch = sortedPosts.map((p) => ({
  slug: p.id.replace(/\.mdx?$/, ''),
  title: p.data.title,
  description: p.data.description,
  excerpt: p.data.excerpt,
  publishedDate: p.data.publishedDate,
  category: p.data.category,
  tags: p.data.tags,
  readingTime: p.data.readingTime,
  featured: p.data.featured
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Flowmator Journal | AI Creative Workflows & Google Flow Guides',
  description: 'In-depth engineering guides, tutorials, and research on Google Flow AI prompt automation, storyboard continuity, and cloud rate-limit management.',
  url: getCanonicalUrl('/blog'),
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.publisher.name,
    url: SITE_CONFIG.publisher.url
  }
};
---

<Layout
  title="The Flowmator Journal | AI Storyboarding, Prompt Automation & Google Flow"
  description="Practical knowledge, technical breakdowns, and production tutorials for Google Flow AI creators, prompt engineers, and visual storytellers."
  canonical={getCanonicalUrl('/blog')}
  schema={schema}
>
  <div class="px-4 py-12 md:py-20 max-w-6xl mx-auto space-y-16">
    
    {/* Page Header */}
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-tier3 text-xs font-semibold uppercase tracking-wider text-violet-electric">
        The Flowmator Journal
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Practical Knowledge for Better AI Creative Workflows
      </h1>
      <p class="text-sm sm:text-base text-brandText-secondary leading-relaxed">
        Engineering breakdowns, tutorials, and field-tested strategies for sequential prompt automation, storyboard continuity, and Google Flow AI.
      </p>
    </div>

    {/* Featured Article Card */}
    {featuredPost && (
      <div class="glass-tier2 rounded-3xl p-6 md:p-10 border border-white/15 relative overflow-hidden shadow-2xl">
        <div class="absolute -right-20 -top-20 w-80 h-80 bg-violet-electric/15 rounded-full blur-3xl pointer-events-none" />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <div class="flex items-center gap-3 text-xs font-mono">
              <span class="px-3 py-1 rounded-full bg-violet-600/30 text-aqua-liquid border border-violet-400/30 font-semibold flex items-center gap-1.5">
                <Sparkles className="w-3.5 h-3.5" /> Featured Publication
              </span>
              <span class="text-brandText-tertiary">{featuredPost.data.category}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight hover:text-violet-electric transition-colors">
              <a href={`/blog/${featuredPost.id.replace(/\.mdx?$/, '')}`}>
                {featuredPost.data.title}
              </a>
            </h2>

            <p class="text-xs sm:text-sm text-brandText-secondary leading-relaxed">
              {featuredPost.data.excerpt}
            </p>

            <div class="flex flex-wrap items-center gap-4 text-xs text-brandText-tertiary pt-2">
              <span class="flex items-center gap-1">
                <Calendar className="w-3.5 h-3.5" /> {featuredPost.data.publishedDate}
              </span>
              <span class="flex items-center gap-1">
                <Clock className="w-3.5 h-3.5" /> {featuredPost.data.readingTime} min read
              </span>
              <span>By {featuredPost.data.author}</span>
            </div>
          </div>

          <div class="lg:col-span-4 flex justify-start lg:justify-end">
            <a
              href={`/blog/${featuredPost.id.replace(/\.mdx?$/, '')}`}
              class="glass-btn-primary px-6 py-3.5 text-xs font-semibold inline-flex items-center gap-2 shadow-xl hover:scale-105 transition-all"
            >
              <span>Read Featured Guide</span>
              <ArrowRight className="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    )}

    {/* Search & Filterable Articles Section */}
    <div class="space-y-6">
      <BlogSearchIsland client:load articles={articlesForSearch} categories={categories} />
    </div>

  </div>
</Layout>
