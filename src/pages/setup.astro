---
import Layout from '../layouts/Layout.astro';
import { Download, Shield, ArrowRight, Search, Star, MessageSquare } from 'lucide-react';

const extensionId = "angiaegmoljbdkhkjkmjligbodgohfpm";
const storeUrl = `https://chromewebstore.google.com/detail/${extensionId}?utm_source=item-share-cb`;
const reviewUrl = `https://chromewebstore.google.com/detail/${extensionId}/reviews`;
---

<Layout
  title="Installation & Setup Guide | Flowmator Chrome Extension"
  description="Step-by-step installation instructions for Flowmator. Install the official extension directly from the Chrome Web Store."
>
  <div class="px-4 py-12 md:py-20 max-w-4xl mx-auto space-y-14">
    
    {/* Page Title */}
    <div class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-tier3 text-xs font-semibold uppercase tracking-wider text-aqua-liquid">
        Quick Setup Guide
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Install & Run Flowmator
      </h1>
      <p class="text-sm sm:text-base text-brandText-secondary max-w-xl mx-auto leading-relaxed">
        Follow our quick walkthrough to install the extension from the Chrome Web Store and launch your first verified prompt queue in under 3 minutes.
      </p>
    </div>

    {/* Installation Content */}
    <div class="space-y-10">
      
      {/* 1. Direct Chrome Web Store Installation */}
      <div class="glass-tier2 rounded-3xl p-6 md:p-10 border border-violet-500/30 space-y-6 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-32 bg-violet-600/10 blur-3xl rounded-full"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
          <div class="space-y-2">
            <div class="flex items-center gap-3">
              <div class="p-2.5 rounded-xl bg-violet-600/20 text-violet-400 border border-violet-500/30">
                <Download className="w-5 h-5" />
              </div>
              <h2 class="text-xl font-bold text-white">Direct Installation (Recommended)</h2>
            </div>
            <p class="text-sm text-brandText-secondary max-w-md">
              The fastest and easiest way to get started. Install the official, verified Flowmator extension directly from the Chrome Web Store in one click.
            </p>
          </div>
          <a 
            href={storeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-semibold transition-all duration-200 shadow-[0_0_20px_rgba(124,58,237,0.3)] hover:shadow-[0_0_25px_rgba(124,58,237,0.5)] whitespace-nowrap"
          >
            Add to Chrome
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>

      {/* 2. Manual Search Guide */}
      <div class="glass-tier2 rounded-3xl p-6 md:p-8 border border-white/15 space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-white/10">
          <div class="p-2.5 rounded-xl bg-blue-500/20 text-blue-400 border border-blue-500/30">
            <Search className="w-5 h-5" />
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">Alternative: Manual Store Search</h3>
            <p class="text-xs text-brandText-secondary">If you prefer to find us yourself</p>
          </div>
        </div>
        
        <ol class="space-y-4">
          {[
            { num: "1", title: "Open the Chrome Web Store", desc: "Navigate to chromewebstore.google.com in your browser." },
            { num: "2", title: "Search for Flowmator", desc: "Type 'Flowmator' into the top search bar and hit Enter." },
            { num: "3", title: "Locate the Extension", desc: "Look for our official extension logo in the search results." },
            { num: "4", title: "Install", desc: "Click into the extension page and click the blue 'Add to Chrome' button." }
          ].map((step) => (
            <li class="flex items-start gap-3 text-xs md:text-sm text-brandText-secondary">
              <span class="w-6 h-6 rounded-full bg-blue-500/20 text-blue-300 font-mono text-xs font-bold flex items-center justify-center shrink-0 border border-blue-400/30 mt-0.5">
                {step.num}
              </span>
              <div>
                <strong class="text-white block">{step.title}</strong>
                <span>{step.desc}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>

      {/* Permissions Breakdown in Plain English */}
      <div class="glass-tier2 rounded-3xl p-6 md:p-8 border border-white/15 space-y-5">
        <div class="flex items-center gap-2">
          <Shield className="w-5 h-5 text-emerald-400" />
          <h3 class="text-lg font-bold text-white">Extension Permissions Explained</h3>
        </div>
        <p class="text-xs text-brandText-secondary leading-relaxed">
          Flowmator strictly requests the minimum Chrome permissions required to automate prompt sequences safely:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
            <span class="font-mono text-aqua-liquid font-semibold">sidePanel</span>
            <p class="text-brandText-tertiary">Renders the tactile control panel alongside Google Flow without obscuring your canvas.</p>
          </div>
          <div class="p-3 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
            <span class="font-mono text-aqua-liquid font-semibold">debugger</span>
            <p class="text-brandText-tertiary">Dispatches hardware-level isTrusted: true keyboard and click events into the ProseMirror editor.</p>
          </div>
          <div class="p-3 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
            <span class="font-mono text-aqua-liquid font-semibold">scripting</span>
            <p class="text-brandText-tertiary">Inspects DOM image tags and error tiles in Google Flow's main page world.</p>
          </div>
          <div class="p-3 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
            <span class="font-mono text-aqua-liquid font-semibold">storage</span>
            <p class="text-brandText-tertiary">Saves prompt queues and custom delay settings locally inside your Chrome profile.</p>
          </div>
        </div>
      </div>

      {/* First Run Walkthrough */}
      <div class="glass-tier2 rounded-3xl p-6 md:p-8 border border-white/15 space-y-4">
        <h3 class="text-lg font-bold text-white">Your First 2-Prompt Test Queue</h3>
        <p class="text-xs text-brandText-secondary leading-relaxed">
          To verify that your installation is working correctly:
        </p>
        <ol class="list-decimal list-inside space-y-2 text-xs text-brandText-secondary">
          <li>Navigate to <a href="https://flow.google.com" target="_blank" class="text-aqua-liquid underline">flow.google.com</a> and sign in with your Google account.</li>
          <li>Click the Flowmator extension icon to open the side panel. Confirm that the top indicator shows <strong class="text-emerald-400">● Flow Connected</strong>.</li>
          <li>Paste two test prompts separated by a blank line or <code class="text-white font-mono">@@@NEXT@@@</code>.</li>
          <li>Keep <strong class="text-white">Safe Sequence Mode</strong> selected and click <strong class="text-violet-electric">Start Flowmator Sequence</strong>.</li>
          <li>Watch the side panel status transition from <em>Generating</em> to <em>Verifying</em> to <em>Completed</em> as Google Flow finishes rendering.</li>
        </ol>
      </div>

      {/* Review CTA Block */}
      <div class="glass-tier3 rounded-3xl p-8 md:p-12 border border-yellow-500/30 text-center space-y-6 bg-gradient-to-b from-yellow-500/5 to-transparent">
        <div class="space-y-3">
          <h3 class="text-2xl font-bold text-white">Loving Flowmator?</h3>
          <p class="text-sm text-brandText-secondary max-w-md mx-auto">
            Your reviews help us grow and keep building awesome automation tools. Let the community know what you think!
          </p>
        </div>

        {/* CSS-Only Hover-Fill Stars (Reversed Array + flex-row-reverse + peer) */}
        <div class="flex items-center justify-center gap-2 flex-row-reverse">
          {[5, 4, 3, 2, 1].map((star) => (
            <a 
              href={reviewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="peer text-brandText-tertiary hover:text-yellow-400 peer-hover:text-yellow-400 transition-colors duration-200 cursor-pointer"
              title={`Rate ${star} Stars`}
            >
              <Star className="w-10 h-10 fill-current" />
            </a>
          ))}
        </div>

        <div class="pt-2">
          <a 
            href={reviewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-white/5 hover:bg-white/10 text-white font-medium border border-white/10 transition-colors"
          >
            <MessageSquare className="w-4 h-4" />
            Write a Review
          </a>
        </div>
      </div>

    </div>

    {/* Need Help Banner */}
    <div class="text-center space-y-3 pt-4">
      <p class="text-xs text-brandText-secondary">Encountering an issue during setup?</p>
      <div class="flex justify-center gap-4">
        <a href="/documentation/troubleshooting" class="text-xs text-aqua-liquid hover:underline font-semibold">
          Troubleshooting Guide ➔
        </a>
        <a href="/support" class="text-xs text-brandText-secondary hover:text-white">
          Support Center
        </a>
      </div>
    </div>

  </div>
</Layout>