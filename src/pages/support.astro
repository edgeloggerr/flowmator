---
import Layout from '../layouts/Layout.astro';
import TroubleshootingAssistant from '../components/TroubleshootingAssistant';
import SupportForm from '../components/SupportForm';
import { HelpCircle, CheckCircle2, MessageSquare, Wrench, Shield, ArrowRight } from 'lucide-react';
---

<Layout
  title="Flowmator Support Center | Diagnostics, FAQs & Ticket Form"
  description="Flowmator creator support. Diagnose Google Flow tab detection issues, input dispatch hurdles, canvas verification timeouts, and format diagnostic reports."
>
  <div class="px-4 py-12 md:py-20 max-w-5xl mx-auto space-y-16">
    
    {/* Page Title */}
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-tier3 text-xs font-semibold uppercase tracking-wider text-aqua-liquid">
        Help & Diagnostics
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Let’s Get Your Workflow Back on Track
      </h1>
      <p class="text-sm sm:text-base text-brandText-secondary leading-relaxed">
        Find verified solutions, diagnose canvas sync hurdles, or generate a formatted diagnostic ticket for the extension maintainers.
      </p>
    </div>

    {/* Section 1: Interactive Troubleshooting Assistant */}
    <div class="space-y-4">
      <TroubleshootingAssistant client:load />
    </div>

    {/* Section 2: Before Contacting Checklist */}
    <div class="glass-tier2 rounded-3xl p-6 md:p-8 border border-white/10 space-y-4">
      <div class="flex items-center gap-2.5">
        <CheckCircle2 className="w-5 h-5 text-emerald-400" />
        <h3 class="text-base font-bold text-white">Before Submitting a Diagnostic Ticket</h3>
      </div>
      <p class="text-xs text-brandText-secondary leading-relaxed">
        Running through these quick checks solves 90% of Google Flow automation hiccups:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
        <div class="p-3.5 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
          <strong class="text-white block">1. Refresh Active Tab</strong>
          <p class="text-brandText-tertiary">Reload flow.google.com to clear any disconnected background WebSockets.</p>
        </div>
        <div class="p-3.5 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
          <strong class="text-white block">2. Close Chrome DevTools</strong>
          <p class="text-brandText-tertiary">If F12 inspect is open on the tab, close it so Flowmator can attach CDP.</p>
        </div>
        <div class="p-3.5 rounded-xl bg-graphite-900/60 border border-white/5 space-y-1">
          <strong class="text-white block">3. Check Extension Status</strong>
          <p class="text-brandText-tertiary">Ensure the sidepanel header displays "● Flow Connected" in emerald.</p>
        </div>
      </div>
    </div>

    {/* Section 3: Diagnostic Ticket Form */}
    <div class="space-y-4">
      <div class="text-center">
        <h2 class="text-xl font-bold text-white">Prepare a Diagnostic Report</h2>
        <p class="text-xs text-brandText-secondary">Structured reporting format for GitHub Issues and maintainer review</p>
      </div>
      <SupportForm client:load />
    </div>

  </div>
</Layout>
